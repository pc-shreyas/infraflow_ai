NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB – leave blank to auto-use in-memory MongoDB
MONGO_URI=

# JWT
JWT_SECRET=infraflow_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Credential Encryption (AES-256-GCM) – 32-char minimum
CREDENTIAL_ENCRYPTION_KEY=infraflow_encryption_key_32chars!

# Redis – leave blank to auto-use in-memory queue
REDIS_URL=

# AI Providers (optional for Phase 1)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
